{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cargo",
            "command": "check",
            "problemMatcher": [
                "$rustc"
            ],
            "label": "cargo check",
            "detail": "Check if the rust project has correct syntax.",
            "options": {
                "cwd": "${workspaceFolder}/lidar-fill-state"
            },
            "icon": {
                "id": "build",
                "color": "terminal.ansiYellow"
            }
        },
        {
            "type": "cargo",
            "command": "build",
            "detail": "Build the rust project.",
            "problemMatcher": [
                "$rustc"
            ],
            "label": "cargo build",
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}/lidar-fill-state"
            },
            "icon": {
                "id": "build",
                "color": "terminal.ansiRed"
            }
        },
        {
            "label": "cargo build (debug)",
            "type": "shell",
            "command": "cargo",
            "detail": "Build the rust project with debug information.",
            "args": [
                "build",
                "--target",
                "riscv32imac-unknown-none-elf"
            ],
            "options": {
                "cwd": "${workspaceFolder}/lidar-fill-state"
            },
            "problemMatcher": ["$rustc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "icon": {
                "id": "build",
                "color": "terminal.ansiMagenta"
            }
        },
        {
            "type": "cargo",
            "command": "run",
            "detail": "Builds the rust project and uploads it to the esp32.",
            "problemMatcher": [
                "$rustc"
            ],
            "label": "cargo run",
            "options": {
                "cwd": "${workspaceFolder}/lidar-fill-state"
            },
            "icon": {
                "color": "terminal.ansiGreen",
                "id": "debug-start"
            },
            "runOptions": {
                "instanceLimit": 1,
                "instancePolicy": "terminateOldest"
            }
        },
        {
            "type": "typescript",
            "tsconfig": "tsconfig.json",
            "problemMatcher": [
                "$tsc"
            ],
            "group": "build",
            "label": "tsc",
            "detail": "Compiles the typescript.",
            "icon": {
                "id": "build",
                "color": "terminal.ansiCyan"
            }
        }
    ]
}