{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cargo",
            "command": "check",
            "problemMatcher": [
                "$rustc"
            ],
            "label": "rust: cargo check",
            "options": {
                "cwd": "${workspaceFolder}/lidar-fill-state"
            }
        },
        {
            "type": "cargo",
            "command": "build",
            "problemMatcher": [
                "$rustc"
            ],
            "label": "rust: cargo build",
            "options": {
                "cwd": "${workspaceFolder}/lidar-fill-state"
            }
        },
        {
            "type": "cargo",
            "command": "run",
            "problemMatcher": [
                "$rustc"
            ],
            "label": "rust: cargo run",
            "options": {
                "cwd": "${workspaceFolder}/lidar-fill-state"
            },
            "icon": {
                "color": "terminal.ansiGreen",
                "id": "debug-start"
            }
        }
    ]
