{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "probe-rs-debug",
            "request": "launch",
            "name": "Flash & Debug",
            "cwd": "${workspaceFolder}/lidar-fill-state",
            "chip": "esp32c6",
            "flashingConfig": {
                "flashingEnabled": true,
                "haltAfterReset": true,
                "formatOptions": {
                    "binaryFormat": "elf"
                }
            },
            "coreConfigs": [
                {
                    "coreIndex": 0,
                    "programBinary": "${workspaceFolder}/lidar-fill-state/target/riscv32imac-unknown-none-elf/debug/lidar-fill-state"
                }
            ],
            "consoleLogLevel": "Debug",
            "preLaunchTask": "cargo build (debug)"
        }
    ]
}