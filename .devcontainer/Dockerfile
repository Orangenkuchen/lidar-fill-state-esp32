FROM rust:1-bookworm

ENV DEBIAN_FRONTEND=noninteractive
# ENV PATH="/root/.cargo/bin:/root/.rustup/toolchain/esp:$PATH"

# Native build utilities and prerequisites for embedded tools.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        # Install tools required for compiling c
        build-essential \
        pkg-config \
        # Python?
        python3 \
        # Install Git
        git \
        # Install Nodejs
        nodejs \
        npm \
        # Install url
        curl \
        ca-certificates \
        && rm -rf /var/lib/apt/lists/* &&\
    # Install Espressif's Rust toolchain and its C compiler toolchains.
    cargo install espup --locked && \
    cargo install espflash --locked && \
    espup install --esp-riscv-gcc && \
    # Install debugger for rust esp32
    cargo install probe-rs-tools && \
    rustup target add riscv32imac-unknown-none-elf && \
    # Load the environment generated by espup in interactive Bash shells.
    echo '. "$HOME/export-esp.sh"' >> /root/.bashrc && \
    # Install TypeScript
    npm install -g typescript

WORKDIR /workspace